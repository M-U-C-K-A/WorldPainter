<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the Info.plist of WorldPainter.app by finish-app.sh: the .world file type, which WorldPainter opens and
     for which the Quick Look extension draws thumbnails. The document icon is made by macOS from the application icon. -->
<plist version="1.0">
<dict>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>WorldPainter World</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.pepsoft.worldpainter.world</string>
            </array>
            <key>CFBundleTypeIconSystemGenerated</key>
            <true/>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.pepsoft.worldpainter.world</string>
            <key>UTTypeDescription</key>
            <string>WorldPainter World</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>world</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/x-worldpainter-world</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
